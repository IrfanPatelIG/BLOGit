<div class="container mt-12">
    <div class="card mx-auto w-fit">
    <div class="card-header">
        <%- locals?.title? locals.title : "Info" %>
    </div>
    <div class="card-body">
        <figure>
        <blockquote class="blockquote">
            <p><%- locals?.infoDesc? locals.infoDesc : "Description" %></p>
        </blockquote>
        <figcaption class="blockquote-footer">
            Source <cite title="Source Title"><%- locals.infoSource? locals.infoSource : "BLOGit Developer - Irfaan"%></cite>
        </figcaption>
        </figure>
    </div>
    </div>
</div>