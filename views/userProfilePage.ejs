<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- locals.user? locals.user.fullName.split(" ")[0] + " - BLOGit" : "User Profile - BLOGit" %></title>
    <%- include("./partials/head") %>
</head>
<body>
    <%- include("./partials/navBar") %>

    <main class="container d-flex gap-4 justify-content-center flex-wrap-reverse"
        style="margin-top: 10px;">
        <div class="container-left" style="margin-right: 12px;">
            <div class="btn-text theme-info fs-xl">Stats</div>
            <div class="d-flex flex-column gap-4 align-items-start">
                <div class="blogs-total btn-subtle theme-primary">Total Blogs: <%- locals.blogs.length %></div>
                <div class="blogs-total btn-subtle theme-primary">Total Comments: <%- locals.comments.length %></div>
                <div class="blogs-total btn-subtle theme-primary">Total My Comments on Blogs: </div>
            </div>
        </div>

        <div class="container-right d-flex justify-content-between flex-row-reverse gap-6 rounded bg-subtle-inverse flex-wrap"
            style="width: fit-content; padding: 24px; padding-inline: 20px;">  
            <div class="profile-image d-flex flex-column justify-content-center align-items-center rounded bg-1"
                style="width: 100%; padding: 10px 0;">
                <div class="avatar w-fit" style="--bs-avatar-size: 10rem;">
                    <img class="avatar-img" src="<%- locals.user.profileImgURL === "/images/defaultProfile.png"? "/images/defaultProfile.png" : "/uploads/profileimages/" + locals.user.profileImgURL%>" alt="profile-image">
                </div>
                <div class="d-flex align-items-center flex-column mt-3">
                    <div class="fullNameDisplay fs-xl">
                        <%- locals.user.fullName %>
                    </div>
                    <div class="emailDisplay fg-emphasis-primary">
                        <%- locals.user.email %>
                    </div>
                </div>
            </div>

            <div class="profile-info w-50"
                style="width: 100%;">
                <div>
                    <form>
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="inputEmail">
                        </div>
                        <div class="mb-3">
                            <label for="inputFullName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="inputFullName">
                        </div>
                        <div class="form-field mb-3">
                            <div>
                                <label for="profileImgURL" class="form-label badge badge-subtle theme-primary fs-md">Profile Image</label>
                                <span class="fg-secondary">Only png/jpeg/jpg</span>
                            </div>
                            <input type="file" accept="image/png, image/jpeg, image/jpg" name="profileImgURL" class="form-control" id="profileImgURL">
                        </div>
                        <button type="submit" class="btn-solid theme-primary mt-3">Update</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include("./partials/scripts") %>
</body>
</html>