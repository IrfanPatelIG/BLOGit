<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- locals?.user? locals?.user.fullName.split(" ")[0] + " - BLOGit" : "User Profile - BLOGit" %></title>
    <%- include("./partials/head") %>
</head>
<body>
    <%- include("./partials/navBar") %>

    <main class="container d-flex gap-6 justify-content-center flex-wrap-reverse"
        style="margin-top: 10px;">
        <div class="container-left" style="margin-right: 24px;">
            <div class="btn-text theme-info fs-xl ">Stats</div>
            <div class="d-flex flex-column gap-4 align-items-start mt-4">
                <div class="blogs-total btn-subtle theme-primary">Total Blogs: <%= locals?.blogs?.length %></div>
                <div class="blogs-total btn-subtle theme-primary">Total Comments: <%= locals?.comments?.length %></div>
                <div class="blogs-total btn-subtle theme-primary">Total Comments on My Blogs: <%= locals?.commentsOnMyBlogs?.length %></div>
            </div>
        </div>

        <div class="container-right d-flex justify-content-between flex-row-reverse gap-6 rounded bg-subtle-inverse flex-wrap"
            style="width: fit-content; padding: 24px; padding-inline: 20px;">  
            <div class="profile-image d-flex flex-column justify-content-center align-items-center rounded bg-1"
                style="width: 100%; padding: 10px 0;">
                <div class="avatar w-fit" style="--bs-avatar-size: 10rem;">
                    <img class="avatar-img" src="<%= locals?.user?.profileImgURL.startsWith("/uploads/profileimages")? locals?.user?.profileImgURL : locals?.user?.profileImgURL === "/images/defaultProfile.png"? "/images/defaultProfile.png" : "/uploads/profileimages/" + locals?.user?.profileImgURL %>" alt="profile-image">
                </div>
                <div class="d-flex align-items-center flex-column mt-3">
                    <div class="fullNameDisplay fs-xl">
                        <%= locals?.user?.fullName %>
                    </div>
                    <div class="emailDisplay fg-emphasis-primary">
                        <%= locals?.user?.email %>
                    </div>
                </div>
            </div>

            <div class="profile-info w-50"
                style="width: 100%;">
                <div>
                    <form action="/user/update-user-profile" method="POST" enctype="multipart/form-data"
                        onsubmit="return confirm('Are you sure you want to Update these values?')">
                        <div class="mb-3">
                            <label for="inputEmail" class="form-label">Email Address<span style="color: red;">*</span></label>
                            <input type="email" name="email" class="form-control" id="inputEmail">
                        </div>
                        <div class="mb-3">
                            <label for="inputFullName" class="form-label">Full Name<span style="color: red;">*</span></label>
                            <input type="text" name="fullName" class="form-control" id="inputFullName">
                        </div>
                        <div class="form-field mb-3">
                            <div>
                                <label for="profileImgURL" class="form-label badge badge-subtle theme-primary fs-md">Profile Image</label>
                                <span class="fg-secondary">Only png/jpeg/jpg</span>
                            </div>
                            <div class="d-flex gap-2">
                                <input type="file" accept="image/png, image/jpeg, image/jpg" name="profileImgURL" class="form-control" id="profileImgURL">
                                <div id="clearBtn" class="align-self-center btn-solid theme-primary mt-3">Clear</div>
                            </div>
                        </div>
                        <button type="submit" id="updateBtn" class="btn-solid theme-primary mt-3" disabled>Update</button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include("./partials/scripts") %>

    <script>
        const email = document.getElementById("inputEmail")
        const fullName = document.getElementById("inputFullName")
        const profileImg = document.getElementById("profileImgURL")
        const updateBtn = document.getElementById("updateBtn")
    
        function checkForm() {
            // For file inputs, .value is non-empty only when a file is selected
            updateBtn.disabled = !(email.value.trim() && fullName.value.trim());
        }

        clearBtn.addEventListener("click", () => {
            profileImg.value = ""
        })

        email.addEventListener('input', checkForm);
        fullName.addEventListener('input', checkForm);
        profileImg.addEventListener('change', checkForm);
    </script>
</body>
</html>