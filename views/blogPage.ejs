<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOGit - <%- locals?.blog?.title %></title>
    <%- include("./partials/head") %>
    <style>
        .container {
            width: 100vw;
            max-height: 85vh;
            margin-top: 12px;
            padding: 0 12px;
            overflow-y: auto;
        }

        .action-buttons {
            width: 8%;
            height: fit-content;
            padding: 6px 4px;
            display: flex;
            flex-direction: column;
            justify-content: end;
            align-items: start;
            gap: 14px;

            position: sticky;
            top: 0px;
            z-index: 25;
        }

        .blog-container {
            width: 90%;
        }

        .comment-container {
            max-height: 400px;
            overflow-y: auto;
            position: sticky;
            top: 40px;
        }

        @media (max-width: 1024px) {
            .sub-container {
                flex-direction: column;
                align-items: center;
            }

            .action-buttons {
                width: 100%;
                flex-direction: row;
                justify-content: start;
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>
    <%- include("./partials/navBar") %>

    <main class="container ">
        <section class="sub-container w-fit d-flex gap-4 justify-content-center">
            <div class="action-buttons menu-translucent">
                <button id="back-btn" class="btn-action sw-100 h-fit theme-primary btn-outline shadow shadow-primary">
                    Go Back
                </button>
                <button id="delete-btn" class="btn-action sw-100 h-fit delete-icon hover-lift btn-outline theme-danger shadow shadow-danger" style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="menu-item-icon" viewBox="0 0 16 16">
                    <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5"/>
                    </svg>
                    Delete
                </button>
            </div>

            <!-- Blog Section -->
            <div class="blog-container card mb-6">
                <img src="<%- locals?.blog.coverImgURL === "/images/defaultCoverImg.png"? 
                        "/images/defaultCoverImg.png" : locals.blog.coverImgURL.startsWith("/uploads/")? 
                        locals.blog.coverImgURL : locals.blog.coverImgURL.startsWith("/images/")? 
                        locals.blog.coverImgURL : "/uploads/" + locals.blog.coverImgURL%>" 
                        class="card-img-top shadow shadow-primary"
                        style="height: 400px; object-fit: contain; object-position: center;"
                        alt="Cover Image">
                <div class="card-body">
                    <div class="card-title mb-3 d-flex gap-2 justify-content-between flex-wrap">
                        <h4 class="title mb-1 align-self-end"><%- locals?.blog?.title %></h4>
                        <div class="author-avatar d-flex gap-2 flex-wrap">
                            <span class="avatar" style="--bs-avatar-size: 3rem;">
                                <img class="avatar-img" src="<%- locals?.blog?.author?.profileImgURL.startsWith("/uploads/profileimages")? blog?.author?.profileImgURL : blog?.author?.profileImgURL === "/images/defaultProfile.png"? "/images/defaultProfile.png" : "/uploads/profileimages/" + blog?.author?.profileImgURL %>" alt="avatar img">
                                <% if (locals?.user) { %>
                                    <% if (user._id.toString() === locals?.blog.author._id.toString()) { %>
                                        <span class="avatar-status status-online" role="img" aria-label="Online"></span>
                                    <% } %>
                                <% }%>
                            </span>
                            <span class="author mb-1 fg-secondary fs-md fst-italic align-self-end">
                                <%- locals?.blog?.author?.fullName %>
                            </span>
                        </div>
                    </div>
                    <pre class="card-text fg-white px-2" style="white-space: pre-wrap; overflow-wrap: anywhere;"><%- blog.description %></pre>
                    <p class="card-date mt-3"><small class="fg-2">Uploaded - <%= getReadableFullDate(blog.createdAt) %></small></p> 
                </div>

                <!-- Comment Section -->
                <section class="comment-container mt-4 mx-4">
                    <h2 class="mb-5">Comments (<%- locals?.comments? comments.length : "0" %>)</h2>
                    
                    <% if (locals?.user) { %> 
                        <!-- Commnet form -->
                        <form action="/blog/comment/<%= locals?.blog._id %>" method="POST">
                             <div class="mb-3">
                                <input type="text" name="content" class="form-control" placeholder="Entet your Comment" required>
                            </div>
                            <button type="submit" class="btn-outline theme-primary mb-6">Comment</button>
                        </form>
                    <% } %>   

                    <!-- Single Comment Card -->
                    <% locals?.comments?.forEach(comment => { %>
                        <div class="comment-card d-flex flex-column gap-2 mb-4 border-bottom">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span class="avatar" style="--bs-avatar-size: 2rem;">
                                        <img class="avatar-img" src="<%= comment.createdBy.profileImgURL %>" alt="avatar img">
                                        <% if (locals?.user?._id.toString() === comment?.createdBy._id.toString()) { %>
                                            <span class="avatar-status status-online" role="img" aria-label="Online"></span>
                                        <% } %>
                                    </span>
                                    <span><%= comment.createdBy.fullName.split(" ")[0] + " " + comment.createdBy.fullName.split(" ")[1] %></span>
                                </div>
                                <div class="d-flex align-items-end gap-4">
                                    <small class="h-fit fg-secondary fs-sm"><%= getReadableFullDate(comment.createdAt) %></small>
                                    <% if (locals?.user) { %>
                                        <% if (user?._id.toString() === comment.createdBy._id.toString()) { %>
                                                <button class="h-fit delete-icon hover-lift align-self-center btn-outline theme-danger shadow-sm shadow-danger" style="cursor: pointer; padding: 4px !important;">
                                                    <a href="/blog/comment/delete/<%= comment._id %>"><img style="width: 25px;" src="/images/trash-white.png" alt="delete icon"></a>
                                                </button>
                                        <% } %> 
                                    <% } %> 
                                </div>
                            </div>
                            <div class="mx-5"><%= comment.content %></div>
                        </div>
                    <% }) %>
                </section>
            </div>
        </section>
    </main>

    <!-- 
    Comment {
        _id: new ObjectId('6ae0fe7f7f0af4933eca4fba'),
        content: 'Great intro',
        blogId: new ObjectId('6ade6550f16f4ad5731375aa'),
        createdBy: new ObjectId('6adcd3448ab7410dd249716c'),
        createdAt: 2026-10-27T19:41:51.174Z,
        updatedAt: 2026-10-27T19:41:51.174Z,
        __v: 0
    }
    -->

    <%- include("./partials/scripts") %>
</body>
</html>